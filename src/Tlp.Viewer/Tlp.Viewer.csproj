<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TheLastPiece</AssemblyName>
    <RootNamespace>Tlp.Viewer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Placeholder icon from logo concept B (docs/logo) until a logo is picked. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <Version>0.3.1</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Trimming drops unused framework code: about 42 MB of the zip down to about 18 MB.
         Only takes effect on publish. MonoTorrent and Mono.Nat are kept whole because they
         use reflection the trimmer can't see. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="MonoTorrent" />
    <TrimmerRootAssembly Include="MonoTorrent.Client" />
    <TrimmerRootAssembly Include="MonoTorrent.Connections" />
    <TrimmerRootAssembly Include="MonoTorrent.Dht" />
    <TrimmerRootAssembly Include="MonoTorrent.Factories" />
    <TrimmerRootAssembly Include="MonoTorrent.PortForwarding" />
    <TrimmerRootAssembly Include="MonoTorrent.Trackers" />
    <TrimmerRootAssembly Include="Mono.Nat" />
    <TrimmerRootAssembly Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <!-- Theme fonts, SIL Open Font License (licenses next to them). -->
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <AvaloniaResource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tlp.Viewer.Core\Tlp.Viewer.Core.csproj" />
  </ItemGroup>

</Project>
