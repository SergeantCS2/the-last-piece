  <!-- The tube: a warm centre fading to the edges, a glow band that rolls down the screen. -->
  <RadialGradientBrush x:Key="TlpWindowBackground" Center="50%,38%" GradientOrigin="50%,38%" RadiusX="75%" RadiusY="75%">
    <GradientStop Color="#2C1D08" Offset="0"/>
    <GradientStop Color="#0B0803" Offset="1"/>
  </RadialGradientBrush>
  <LinearGradientBrush x:Key="TlpBand" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Color="#00FFB641" Offset="0"/>
    <GradientStop Color="#12FFB641" Offset="0.5"/>
    <GradientStop Color="#00FFB641" Offset="1"/>
  </LinearGradientBrush>
  <DropShadowEffect x:Key="TlpTitleEffect" Color="#FFB641" BlurRadius="18" OffsetX="0" OffsetY="0" Opacity="1.0"/>
  <DropShadowEffect x:Key="TlpSoftGlow" Color="#FFB641" BlurRadius="8" OffsetX="0" OffsetY="0" Opacity="0.8"/>
</ResourceDictionary>
