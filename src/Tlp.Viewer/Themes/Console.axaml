<!--
  Draft theme "Console". Tech: clean developer dashboard, slate blue with a cyan accent, monospaced headings.
  Our own colours and freely licensed fonts (SIL Open Font License, see Assets/Fonts/licenses).
  Generated layout of keys matches Default.axaml.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="Tlp.Viewer.Themes.ConsoleTheme">
  <SolidColorBrush x:Key="TlpWindowBackground" Color="#0B1220"/>
  <SolidColorBrush x:Key="TlpSurface" Color="#111B2E"/>
  <SolidColorBrush x:Key="TlpInput" Color="#0D1626"/>
  <SolidColorBrush x:Key="TlpBorder" Color="#22324F"/>
  <SolidColorBrush x:Key="TlpText" Color="#E2E8F0"/>
  <SolidColorBrush x:Key="TlpMutedText" Color="#8DA0BB"/>
  <SolidColorBrush x:Key="TlpAccent" Color="#38BDF8"/>
  <SolidColorBrush x:Key="TlpAccentText" Color="#04121F"/>
  <LinearGradientBrush x:Key="TlpProgress" StartPoint="0%,0%" EndPoint="100%,0%"><LinearGradientBrush.GradientStops><GradientStop Color="#38BDF8" Offset="0"/><GradientStop Color="#34D399" Offset="1"/></LinearGradientBrush.GradientStops></LinearGradientBrush>
  <SolidColorBrush x:Key="TlpTitleForeground" Color="#7DD3FC"/>
  <FontFamily x:Key="TlpBodyFont">fonts:Inter#Inter, $Default</FontFamily>
  <FontFamily x:Key="TlpTitleFont">avares://TheLastPiece/Assets/Fonts#JetBrains Mono, $Default</FontFamily>
  <x:Double x:Key="TlpTitleSize">26</x:Double>
  <x:Double x:Key="TlpTitleSpacing">0</x:Double>
  <x:Double x:Key="TlpHeadingSize">18</x:Double>
  <x:Double x:Key="TlpSmallSize">12</x:Double>
  <x:Double x:Key="TlpBodySize">14</x:Double>
  <CornerRadius x:Key="TlpCorner">6</CornerRadius>
  <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
  <Color x:Key="SystemAccentColor">#38BDF8</Color>
  
  <x:String x:Key="TlpVariant">Dark</x:String>
</ResourceDictionary>
