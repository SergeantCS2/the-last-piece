<!--
  Draft theme "Sakura". Anime: soft pastel pinks and lilac, rounded friendly type, big soft corners.
  Our own colours and freely licensed fonts (SIL Open Font License, see Assets/Fonts/licenses).
  Generated layout of keys matches Default.axaml.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="Tlp.Viewer.Themes.SakuraTheme">
  <LinearGradientBrush x:Key="TlpWindowBackground" StartPoint="0%,0%" EndPoint="100%,100%"><LinearGradientBrush.GradientStops><GradientStop Color="#FFF4F8" Offset="0"/><GradientStop Color="#F1ECFF" Offset="1"/></LinearGradientBrush.GradientStops></LinearGradientBrush>
  <SolidColorBrush x:Key="TlpSurface" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="TlpInput" Color="#FFF8FB"/>
  <SolidColorBrush x:Key="TlpBorder" Color="#F6C3D5"/>
  <SolidColorBrush x:Key="TlpText" Color="#3B2C4D"/>
  <SolidColorBrush x:Key="TlpMutedText" Color="#8C7A9E"/>
  <LinearGradientBrush x:Key="TlpAccent" StartPoint="0%,0%" EndPoint="100%,0%"><LinearGradientBrush.GradientStops><GradientStop Color="#FF5C8A" Offset="0"/><GradientStop Color="#A06BFF" Offset="1"/></LinearGradientBrush.GradientStops></LinearGradientBrush>
  <SolidColorBrush x:Key="TlpAccentText" Color="#FFFFFF"/>
  <LinearGradientBrush x:Key="TlpProgress" StartPoint="0%,0%" EndPoint="100%,0%"><LinearGradientBrush.GradientStops><GradientStop Color="#FF5C8A" Offset="0"/><GradientStop Color="#A06BFF" Offset="1"/></LinearGradientBrush.GradientStops></LinearGradientBrush>
  <LinearGradientBrush x:Key="TlpTitleForeground" StartPoint="0%,0%" EndPoint="100%,0%"><LinearGradientBrush.GradientStops><GradientStop Color="#FF4F86" Offset="0"/><GradientStop Color="#8E6BFF" Offset="1"/></LinearGradientBrush.GradientStops></LinearGradientBrush>
  <FontFamily x:Key="TlpBodyFont">avares://TheLastPiece/Assets/Fonts#Nunito, $Default</FontFamily>
  <FontFamily x:Key="TlpTitleFont">avares://TheLastPiece/Assets/Fonts#Nunito ExtraBold, avares://TheLastPiece/Assets/Fonts#Nunito, $Default</FontFamily>
  <x:Double x:Key="TlpTitleSize">30</x:Double>
  <x:Double x:Key="TlpTitleSpacing">0.5</x:Double>
  <x:Double x:Key="TlpHeadingSize">19</x:Double>
  <x:Double x:Key="TlpSmallSize">12</x:Double>
  <x:Double x:Key="TlpBodySize">14</x:Double>
  <CornerRadius x:Key="TlpCorner">16</CornerRadius>
  <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
  <Color x:Key="SystemAccentColor">#FF5C8A</Color>
  
  <x:String x:Key="TlpVariant">Light</x:String>
</ResourceDictionary>
