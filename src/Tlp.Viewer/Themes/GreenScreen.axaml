<!--
  Draft theme "Green Screen". Retro terminal: green phosphor on black with scanlines, all pixel type, inspired by 1950s-future computer terminals.
  Our own colours and freely licensed fonts (SIL Open Font License, see Assets/Fonts/licenses).
  Generated layout of keys matches Default.axaml.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="Tlp.Viewer.Themes.GreenScreenTheme">
  <DrawingBrush x:Key="TlpWindowBackground" TileMode="Tile" DestinationRect="0,0,4,4" SourceRect="0,0,4,4" Stretch="None">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#050B06" Geometry="M0,0 H4 V4 H0 Z"/>
          <GeometryDrawing Brush="#0A160C" Geometry="M0,3 H4 V4 H0 Z"/>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
  <SolidColorBrush x:Key="TlpSurface" Color="#07130A"/>
  <SolidColorBrush x:Key="TlpInput" Color="#030803"/>
  <SolidColorBrush x:Key="TlpBorder" Color="#1E7A33"/>
  <SolidColorBrush x:Key="TlpText" Color="#46FF7A"/>
  <SolidColorBrush x:Key="TlpMutedText" Color="#24B04C"/>
  <SolidColorBrush x:Key="TlpAccent" Color="#33FF66"/>
  <SolidColorBrush x:Key="TlpAccentText" Color="#031006"/>
  <SolidColorBrush x:Key="TlpProgress" Color="#33FF66"/>
  <SolidColorBrush x:Key="TlpTitleForeground" Color="#5CFF8A"/>
  <FontFamily x:Key="TlpBodyFont">avares://TheLastPiece/Assets/Fonts#VT323, $Default</FontFamily>
  <FontFamily x:Key="TlpTitleFont">avares://TheLastPiece/Assets/Fonts#VT323, $Default</FontFamily>
  <x:Double x:Key="TlpTitleSize">40</x:Double>
  <x:Double x:Key="TlpTitleSpacing">2</x:Double>
  <x:Double x:Key="TlpHeadingSize">24</x:Double>
  <x:Double x:Key="TlpSmallSize">16</x:Double>
  <x:Double x:Key="TlpBodySize">19</x:Double>
  <CornerRadius x:Key="TlpCorner">0</CornerRadius>
  <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
  <Color x:Key="SystemAccentColor">#33FF66</Color>
  <DropShadowEffect x:Key="TlpTitleEffect" Color="#33FF66" BlurRadius="10" OffsetX="0" OffsetY="0" Opacity="0.9"/>
  <x:String x:Key="TlpVariant">Dark</x:String>
</ResourceDictionary>
