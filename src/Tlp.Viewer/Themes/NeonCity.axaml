<!--
  Draft theme "Neon City". Cyberpunk: near-black with hazard yellow and electric cyan, hard edges, wide techno headings.
  Our own colours and freely licensed fonts (SIL Open Font License, see Assets/Fonts/licenses).
  Generated layout of keys matches Default.axaml.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="Tlp.Viewer.Themes.NeonCityTheme">
  <DrawingBrush x:Key="TlpWindowBackground" TileMode="Tile" DestinationRect="0,0,40,40" SourceRect="0,0,40,40" Stretch="None">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#09090D" Geometry="M0,0 H40 V40 H0 Z"/>
          <GeometryDrawing Brush="#16161F" Geometry="M0,39 H40 V40 H0 Z M39,0 H40 V40 H39 Z"/>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
  <SolidColorBrush x:Key="TlpSurface" Color="#111118"/>
  <SolidColorBrush x:Key="TlpInput" Color="#0B0B10"/>
  <SolidColorBrush x:Key="TlpBorder" Color="#7A730A"/>
  <SolidColorBrush x:Key="TlpText" Color="#F1F1F4"/>
  <SolidColorBrush x:Key="TlpMutedText" Color="#8F8FA6"/>
  <SolidColorBrush x:Key="TlpAccent" Color="#FCEE0A"/>
  <SolidColorBrush x:Key="TlpAccentText" Color="#09090D"/>
  <SolidColorBrush x:Key="TlpProgress" Color="#00F0FF"/>
  <SolidColorBrush x:Key="TlpTitleForeground" Color="#FCEE0A"/>
  <FontFamily x:Key="TlpBodyFont">avares://TheLastPiece/Assets/Fonts#Rajdhani Medium, avares://TheLastPiece/Assets/Fonts#Rajdhani, $Default</FontFamily>
  <FontFamily x:Key="TlpTitleFont">avares://TheLastPiece/Assets/Fonts#Orbitron ExtraBold, avares://TheLastPiece/Assets/Fonts#Orbitron, $Default</FontFamily>
  <x:Double x:Key="TlpTitleSize">28</x:Double>
  <x:Double x:Key="TlpTitleSpacing">4</x:Double>
  <x:Double x:Key="TlpHeadingSize">20</x:Double>
  <x:Double x:Key="TlpSmallSize">13</x:Double>
  <x:Double x:Key="TlpBodySize">15</x:Double>
  <CornerRadius x:Key="TlpCorner">0</CornerRadius>
  <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
  <Color x:Key="SystemAccentColor">#FCEE0A</Color>
  <DropShadowEffect x:Key="TlpTitleEffect" Color="#FCEE0A" BlurRadius="10" OffsetX="0" OffsetY="0" Opacity="0.9"/>
  <x:String x:Key="TlpVariant">Dark</x:String>
</ResourceDictionary>
