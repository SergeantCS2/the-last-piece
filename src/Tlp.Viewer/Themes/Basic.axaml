<!--
  The Default look: plain and ordinary on purpose (2026-11-02). System-style colours, one
  font (Inter, bundled with Avalonia), a standard blue accent, no glow, no clock, no motion. It
  follows Windows light or dark mode and uses only the shared styles in Styles.axaml.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="Tlp.Viewer.Themes.BasicTheme">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="TlpWindowBackground" Color="#F3F3F3"/>
      <SolidColorBrush x:Key="TlpSurface" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="TlpBorder" Color="#E0E0E0"/>
      <SolidColorBrush x:Key="TlpBorderHi" Color="#C4C4C4"/>
      <SolidColorBrush x:Key="TlpText" Color="#1B1B1B"/>
      <SolidColorBrush x:Key="TlpTextHi" Color="#000000"/>
      <SolidColorBrush x:Key="TlpMutedText" Color="#616161"/>
      <SolidColorBrush x:Key="TlpAccent" Color="#005FB8"/>
      <SolidColorBrush x:Key="TlpAccentHover" Color="#1A6FC0"/>
      <SolidColorBrush x:Key="TlpAccentText" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="TlpAccentSoft" Color="#14005FB8"/>
      <SolidColorBrush x:Key="TlpProgress" Color="#005FB8"/>
      <SolidColorBrush x:Key="TlpProgressTrack" Color="#E5E5E5"/>
      <SolidColorBrush x:Key="TlpInput" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="TlpHover" Color="#F0F0F0"/>
      <SolidColorBrush x:Key="TlpTitleForeground" Color="#1B1B1B"/>
      <BoxShadows x:Key="TlpCardShadow">0 0 0 0 #00000000</BoxShadows>
      <SolidColorBrush x:Key="TlpGlowBrush" Color="Transparent"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="TlpWindowBackground" Color="#202020"/>
      <SolidColorBrush x:Key="TlpSurface" Color="#2B2B2B"/>
      <SolidColorBrush x:Key="TlpBorder" Color="#3A3A3A"/>
      <SolidColorBrush x:Key="TlpBorderHi" Color="#4F4F4F"/>
      <SolidColorBrush x:Key="TlpText" Color="#F3F3F3"/>
      <SolidColorBrush x:Key="TlpTextHi" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="TlpMutedText" Color="#ABABAB"/>
      <SolidColorBrush x:Key="TlpAccent" Color="#4CC2FF"/>
      <SolidColorBrush x:Key="TlpAccentHover" Color="#6CCBFF"/>
      <SolidColorBrush x:Key="TlpAccentText" Color="#000000"/>
      <SolidColorBrush x:Key="TlpAccentSoft" Color="#1F4CC2FF"/>
      <SolidColorBrush x:Key="TlpProgress" Color="#4CC2FF"/>
      <SolidColorBrush x:Key="TlpProgressTrack" Color="#3A3A3A"/>
      <SolidColorBrush x:Key="TlpInput" Color="#1F1F1F"/>
      <SolidColorBrush x:Key="TlpHover" Color="#333333"/>
      <SolidColorBrush x:Key="TlpTitleForeground" Color="#FFFFFF"/>
      <BoxShadows x:Key="TlpCardShadow">0 0 0 0 #00000000</BoxShadows>
      <SolidColorBrush x:Key="TlpGlowBrush" Color="Transparent"/>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <FontFamily x:Key="TlpBodyFont">fonts:Inter#Inter, $Default</FontFamily>
  <FontFamily x:Key="TlpTitleFont">fonts:Inter#Inter, $Default</FontFamily>
  <FontFamily x:Key="TlpHeadFont">fonts:Inter#Inter, $Default</FontFamily>
  <x:Double x:Key="TlpTitleSize">28</x:Double>
  <x:Double x:Key="TlpTitleSpacing">0</x:Double>
  <x:Double x:Key="TlpHeadingSize">18</x:Double>
  <x:Double x:Key="TlpSmallSize">12</x:Double>
  <x:Double x:Key="TlpBodySize">14</x:Double>
  <x:Double x:Key="TlpHeadSize">13</x:Double>
  <CornerRadius x:Key="TlpCorner">4</CornerRadius>
  <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
  <Color x:Key="SystemAccentColor">#005FB8</Color>
  <Color x:Key="SystemAccentColorDark1">#004C93</Color>
  <Color x:Key="SystemAccentColorLight1">#4CC2FF</Color>
  <x:String x:Key="TlpVariant">Default</x:String>
</ResourceDictionary>
