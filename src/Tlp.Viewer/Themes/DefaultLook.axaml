<!--
  The default look's parts: soft cards with a small caps label, the app's puzzle-piece mark beside
  its name, a faint warm glow in the corner, and a clock. Quiet on purpose: it should suit any
  night. Fonts Space Grotesk (SIL OFL) for the title and Inter for the rest.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="using:Tlp.Viewer.Decor"
        x:Class="Tlp.Viewer.Themes.DefaultLook">
  <Style Selector="ContentControl.backdrop">
    <Setter Property="Template">
      <ControlTemplate>
        <Rectangle Fill="{DynamicResource TlpGlowBrush}"/>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="ContentControl.kicker">
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="Horizontal" Spacing="7" Margin="1,0,0,2">
          <!-- The puzzle piece from the logo ideas, as a small mark. -->
          <Viewbox Width="14" Height="14" VerticalAlignment="Center">
            <Path Fill="{DynamicResource TlpAccent}" Data="M20,20 H40 A10,10 0 1,1 60,20 H80 V40 A10,10 0 1,1 80,60 V80 H20 V60 A10,10 0 1,0 20,40 Z"/>
          </Viewbox>
          <TextBlock Text="{TemplateBinding Content, Converter={x:Static d:UpperConverter.Instance}}" FontSize="11" FontWeight="SemiBold"
                     LetterSpacing="2" Foreground="{DynamicResource TlpMutedText}" VerticalAlignment="Center"/>
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style Selector="ContentControl.side">
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel HorizontalAlignment="Right">
          <d:Clock Format="t" HorizontalAlignment="Right" FontFamily="{DynamicResource TlpTitleFont}" FontWeight="Bold" FontSize="22" Foreground="{DynamicResource TlpText}"/>
          <d:Clock Format="dddd d MMMM" HorizontalAlignment="Right" FontSize="11.5" Foreground="{DynamicResource TlpMutedText}"/>
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="HeaderedContentControl.panel">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{DynamicResource TlpSurface}" BorderBrush="{DynamicResource TlpBorder}" BorderThickness="1"
                CornerRadius="14" BoxShadow="{DynamicResource TlpCardShadow}" Padding="18,14,18,16">
          <DockPanel>
            <ContentPresenter x:Name="PART_HeaderPresenter" DockPanel.Dock="Top" Margin="0,0,0,10"
                              Content="{TemplateBinding Header, Converter={x:Static d:UpperConverter.Instance}}"
                              FontSize="{DynamicResource TlpHeadSize}" FontWeight="SemiBold" Foreground="{DynamicResource TlpMutedText}"/>
            <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.exphead">
    <Setter Property="FontSize" Value="{DynamicResource TlpHeadSize}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock x:Name="chev" Text="▸" Foreground="{TemplateBinding Foreground}"/>
            <TextBlock Text="{TemplateBinding Content, Converter={x:Static d:UpperConverter.Instance}}" Foreground="{TemplateBinding Foreground}"/>
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="ContentControl.statusbar">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{DynamicResource TlpSurface}" BorderBrush="{DynamicResource TlpBorder}" BorderThickness="1" CornerRadius="14"
                BoxShadow="{DynamicResource TlpCardShadow}" Padding="18,10,10,10">
          <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Border.item">
    <Setter Property="Background" Value="{DynamicResource TlpInput}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource TlpBorder}"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="14,10"/>
  </Style>

  <Style Selector="TextBlock.heading">
    <Setter Property="FontFamily" Value="{DynamicResource TlpTitleFont}"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="MinHeight" Value="6"/>
    <Setter Property="CornerRadius" Value="3"/>
    <Setter Property="Background" Value="{DynamicResource TlpProgressTrack}"/>
  </Style>

  <Style Selector="Button">
    <Setter Property="Padding" Value="14,7"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Background" Value="{DynamicResource TlpSurface}"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TlpHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource TlpBorderHi}"/>
    <Setter Property="Foreground" Value="{DynamicResource TlpText}"/>
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="BorderBrush" Value="{DynamicResource TlpAccent}"/>
    <Setter Property="Padding" Value="18,7"/>
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TlpAccentHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource TlpAccentHover}"/>
    <Setter Property="Foreground" Value="{DynamicResource TlpAccentText}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>
</Styles>
