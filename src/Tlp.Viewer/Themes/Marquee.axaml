<!--
  Draft theme "Marquee". Movie and fantasy: old cinema marquee, deep velvet red, gold engraved titles, serif type.
  Our own colours and freely licensed fonts (SIL Open Font License, see Assets/Fonts/licenses).
  Generated layout of keys matches Default.axaml.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="Tlp.Viewer.Themes.MarqueeTheme">
  <LinearGradientBrush x:Key="TlpWindowBackground" StartPoint="0%,0%" EndPoint="0%,100%"><LinearGradientBrush.GradientStops><GradientStop Color="#22100F" Offset="0"/><GradientStop Color="#140A0B" Offset="1"/></LinearGradientBrush.GradientStops></LinearGradientBrush>
  <SolidColorBrush x:Key="TlpSurface" Color="#26161A"/>
  <SolidColorBrush x:Key="TlpInput" Color="#1C1013"/>
  <SolidColorBrush x:Key="TlpBorder" Color="#5E3F27"/>
  <SolidColorBrush x:Key="TlpText" Color="#F3E6CC"/>
  <SolidColorBrush x:Key="TlpMutedText" Color="#B59E80"/>
  <LinearGradientBrush x:Key="TlpAccent" StartPoint="0%,0%" EndPoint="0%,100%"><LinearGradientBrush.GradientStops><GradientStop Color="#F1CF7A" Offset="0"/><GradientStop Color="#B8862E" Offset="1"/></LinearGradientBrush.GradientStops></LinearGradientBrush>
  <SolidColorBrush x:Key="TlpAccentText" Color="#1A0E08"/>
  <LinearGradientBrush x:Key="TlpProgress" StartPoint="0%,0%" EndPoint="100%,0%"><LinearGradientBrush.GradientStops><GradientStop Color="#F1CF7A" Offset="0"/><GradientStop Color="#B8862E" Offset="1"/></LinearGradientBrush.GradientStops></LinearGradientBrush>
  <LinearGradientBrush x:Key="TlpTitleForeground" StartPoint="0%,0%" EndPoint="0%,100%"><LinearGradientBrush.GradientStops><GradientStop Color="#F7DC8C" Offset="0"/><GradientStop Color="#B8862E" Offset="1"/></LinearGradientBrush.GradientStops></LinearGradientBrush>
  <FontFamily x:Key="TlpBodyFont">avares://TheLastPiece/Assets/Fonts#Lora, $Default</FontFamily>
  <FontFamily x:Key="TlpTitleFont">avares://TheLastPiece/Assets/Fonts#Cinzel, $Default</FontFamily>
  <x:Double x:Key="TlpTitleSize">30</x:Double>
  <x:Double x:Key="TlpTitleSpacing">3</x:Double>
  <x:Double x:Key="TlpHeadingSize">19</x:Double>
  <x:Double x:Key="TlpSmallSize">12</x:Double>
  <x:Double x:Key="TlpBodySize">14</x:Double>
  <CornerRadius x:Key="TlpCorner">4</CornerRadius>
  <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
  <Color x:Key="SystemAccentColor">#D9A84E</Color>
  
  <x:String x:Key="TlpVariant">Dark</x:String>
</ResourceDictionary>
