<!--
  The parts every look shares, and the plain look's templates. A theme (Themes/README.md) brings
  its own keys and can override any of these styles, including whole templates.

  Parts of the window a theme can restyle (all in MainWindow.axaml):
    ContentControl.backdrop / .overlay   decor layers behind / above the app, mouse-transparent
    Border.titlebar, Button.caption      the app's own title bar and its minimise, maximise and close
                                         buttons (.close is the close button)
    ContentControl.side                  the header's right-hand corner (clock, stamp, ticket...)
    ContentControl.brand                 the title (the host's group name)
    HeaderedContentControl.panel         the "Queue" and "Files" boxes, and Settings when open (an
                                         Expander drawn as a panel with a ToggleButton.exphead header)
    ToggleButton.expbar                  Settings when closed: a full-width bar that reads as a button
    ContentControl.statusbar             the status line with the Join button
    Border.item                          one file in the list
  Those parts carry the class "still" while the window is in the background: a theme's motion
  goes in styles that say :not(.still), so it stops when nobody is looking.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <!-- Name of the top panel (this session's files). A look can give its own in its Styles.Resources. -->
    <x:String x:Key="TlpNightLabel">Queue</x:String>
  </Styles.Resources>
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource TlpWindowBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource TlpText}"/>
    <Setter Property="FontFamily" Value="{DynamicResource TlpBodyFont}"/>
    <Setter Property="FontSize" Value="{DynamicResource TlpBodySize}"/>
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontFamily" Value="{DynamicResource TlpTitleFont}"/>
    <Setter Property="FontSize" Value="{DynamicResource TlpTitleSize}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TlpTitleForeground}"/>
    <Setter Property="LetterSpacing" Value="{DynamicResource TlpTitleSpacing}"/>
    <Setter Property="Effect" Value="{DynamicResource TlpTitleEffect}"/>
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="{DynamicResource TlpHeadingSize}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="{DynamicResource TlpSmallSize}"/>
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TlpMutedText}"/>
  </Style>

  <!-- Header: the title alone (no app-name line above it). -->
  <Style Selector="ContentControl.brand">
    <Setter Property="Template">
      <ControlTemplate>
        <TextBlock Classes="title" Text="{TemplateBinding Content}"/>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- A panel: a box with its name at the top. -->
  <Style Selector="HeaderedContentControl.panel">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{DynamicResource TlpSurface}" BorderBrush="{DynamicResource TlpBorder}" BorderThickness="1"
                CornerRadius="{DynamicResource TlpCorner}" Padding="14,10,14,14">
          <DockPanel>
            <ContentPresenter x:Name="PART_HeaderPresenter" DockPanel.Dock="Top" Margin="0,0,0,8" Content="{TemplateBinding Header}"
                              FontSize="{DynamicResource TlpSmallSize}" FontWeight="SemiBold" Foreground="{DynamicResource TlpMutedText}"/>
            <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- Settings: closed, a full-width bar that reads as a button (ToggleButton.expbar); open, a panel
       whose name closes it again. -->
  <Style Selector="Expander">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
        <ToggleButton Classes="expbar" Content="{TemplateBinding Header}" IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                      IsVisible="{Binding !IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
        <HeaderedContentControl Classes="panel" IsVisible="{TemplateBinding IsExpanded}">
          <HeaderedContentControl.Header>
            <ToggleButton Classes="exphead" Content="{TemplateBinding Header}" IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"/>
          </HeaderedContentControl.Header>
          <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Margin="0,4,0,0"/>
        </HeaderedContentControl>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.expbar">
    <Setter Property="Background" Value="{DynamicResource TlpSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource TlpBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource TlpText}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource TlpCorner}" Padding="14,10">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="Name, folder, look and more" VerticalAlignment="Center"
                       FontSize="{DynamicResource TlpSmallSize}" Foreground="{DynamicResource TlpMutedText}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="▸" VerticalAlignment="Center" Foreground="{DynamicResource TlpAccent}"/>
              <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" VerticalAlignment="Center"
                                FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}"/>
            </StackPanel>
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.expbar:pointerover">
    <Setter Property="Background" Value="{DynamicResource TlpHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource TlpAccent}"/>
  </Style>
  <Style Selector="ToggleButton.exphead">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TlpMutedText}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock x:Name="chev" Text="▸" Foreground="{TemplateBinding Foreground}"/>
            <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.exphead:checked /template/ TextBlock#chev">
    <Setter Property="Text" Value="▾"/>
  </Style>
  <Style Selector="ToggleButton.exphead:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource TlpText}"/>
  </Style>

  <!-- The app's title bar and its minimise, maximise and close buttons. -->
  <Style Selector="Border.titlebar">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="TextBlock.wintitle">
    <Setter Property="FontSize" Value="{DynamicResource TlpSmallSize}"/>
    <Setter Property="Foreground" Value="{DynamicResource TlpMutedText}"/>
  </Style>
  <Style Selector="Button.caption">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource TlpMutedText}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.caption Path.glyph">
    <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    <Setter Property="StrokeThickness" Value="1"/>
    <Setter Property="Width" Value="10"/>
    <Setter Property="Height" Value="10"/>
  </Style>
  <Style Selector="Button.caption:pointerover">
    <Setter Property="Background" Value="{DynamicResource TlpHover}"/>
    <Setter Property="Foreground" Value="{DynamicResource TlpText}"/>
  </Style>
  <Style Selector="Button.caption.close:pointerover">
    <Setter Property="Background" Value="#E81123"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
  </Style>
  <Style Selector="Button.caption:pressed">
    <Setter Property="Opacity" Value="0.8"/>
  </Style>

  <Style Selector="ContentControl.statusbar">
    <Setter Property="Template">
      <ControlTemplate>
        <Border BorderBrush="{DynamicResource TlpBorder}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
          <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Border.item">
    <Setter Property="Background" Value="{DynamicResource TlpInput}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource TlpBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource TlpCorner}"/>
    <Setter Property="Padding" Value="12"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource TlpSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource TlpBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource TlpCorner}"/>
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource TlpProgress}"/>
    <Setter Property="Height" Value="6"/>
  </Style>
  <Style Selector="TextBox, ComboBox">
    <Setter Property="Background" Value="{DynamicResource TlpInput}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource TlpBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource TlpText}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource TlpCorner}"/>
  </Style>
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource TlpInput}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource TlpBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource TlpText}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource TlpCorner}"/>
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TlpText}"/>
  </Style>
  <Style Selector="CheckBox /template/ ContentPresenter#ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TlpText}"/>
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource TlpAccent}"/>
    <Setter Property="Foreground" Value="{DynamicResource TlpAccentText}"/>
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TlpAccent}"/>
    <Setter Property="Foreground" Value="{DynamicResource TlpAccentText}"/>
    <Setter Property="Opacity" Value="0.9"/>
  </Style>
</Styles>
