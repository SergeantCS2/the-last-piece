<!--
  Draft theme "Outrun". Synthwave: purple dusk sky, hot pink and cyan, sunset gradient title with a soft glow.
  Our own colours and freely licensed fonts (SIL Open Font License, see Assets/Fonts/licenses).
  Generated layout of keys matches Default.axaml.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="Tlp.Viewer.Themes.OutrunTheme">
  <LinearGradientBrush x:Key="TlpWindowBackground" StartPoint="0%,0%" EndPoint="0%,100%"><LinearGradientBrush.GradientStops><GradientStop Color="#1A0B3B" Offset="0"/><GradientStop Color="#3A0D52" Offset="0.6"/><GradientStop Color="#5A1250" Offset="1"/></LinearGradientBrush.GradientStops></LinearGradientBrush>
  <SolidColorBrush x:Key="TlpSurface" Color="#2A1150"/>
  <SolidColorBrush x:Key="TlpInput" Color="#1F0C3D"/>
  <SolidColorBrush x:Key="TlpBorder" Color="#FF3EA5"/>
  <SolidColorBrush x:Key="TlpText" Color="#FBEAFF"/>
  <SolidColorBrush x:Key="TlpMutedText" Color="#C2A3E3"/>
  <LinearGradientBrush x:Key="TlpAccent" StartPoint="0%,0%" EndPoint="100%,0%"><LinearGradientBrush.GradientStops><GradientStop Color="#FF3EA5" Offset="0"/><GradientStop Color="#FF8A3D" Offset="1"/></LinearGradientBrush.GradientStops></LinearGradientBrush>
  <SolidColorBrush x:Key="TlpAccentText" Color="#FFFFFF"/>
  <LinearGradientBrush x:Key="TlpProgress" StartPoint="0%,0%" EndPoint="100%,0%"><LinearGradientBrush.GradientStops><GradientStop Color="#FF3EA5" Offset="0"/><GradientStop Color="#00E5FF" Offset="1"/></LinearGradientBrush.GradientStops></LinearGradientBrush>
  <LinearGradientBrush x:Key="TlpTitleForeground" StartPoint="0%,0%" EndPoint="0%,100%"><LinearGradientBrush.GradientStops><GradientStop Color="#FFD23D" Offset="0"/><GradientStop Color="#FF3EA5" Offset="0.55"/><GradientStop Color="#B23DFF" Offset="1"/></LinearGradientBrush.GradientStops></LinearGradientBrush>
  <FontFamily x:Key="TlpBodyFont">fonts:Inter#Inter, $Default</FontFamily>
  <FontFamily x:Key="TlpTitleFont">avares://TheLastPiece/Assets/Fonts#Audiowide, $Default</FontFamily>
  <x:Double x:Key="TlpTitleSize">30</x:Double>
  <x:Double x:Key="TlpTitleSpacing">2</x:Double>
  <x:Double x:Key="TlpHeadingSize">18</x:Double>
  <x:Double x:Key="TlpSmallSize">12</x:Double>
  <x:Double x:Key="TlpBodySize">14</x:Double>
  <CornerRadius x:Key="TlpCorner">10</CornerRadius>
  <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
  <Color x:Key="SystemAccentColor">#FF3EA5</Color>
  <DropShadowEffect x:Key="TlpTitleEffect" Color="#FF3EA5" BlurRadius="14" OffsetX="0" OffsetY="0" Opacity="0.9"/>
  <x:String x:Key="TlpVariant">Dark</x:String>
</ResourceDictionary>
