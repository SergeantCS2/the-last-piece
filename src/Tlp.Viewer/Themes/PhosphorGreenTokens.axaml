  <SolidColorBrush x:Key="TlpAlert" Color="#FFB641"/>
  <SolidColorBrush x:Key="TlpHover" Color="#0B2415"/>
  <SolidColorBrush x:Key="TlpGlow" Color="#8045FF86"/>
