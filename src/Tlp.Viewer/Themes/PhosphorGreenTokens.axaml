  <FontFamily x:Key="TlpTitleFont">avares://TheLastPiece/Assets/Fonts#VT323, $Default</FontFamily>
  <FontFamily x:Key="TlpBodyFont">avares://TheLastPiece/Assets/Fonts#IBM Plex Mono, $Default</FontFamily>
  <FontFamily x:Key="TlpHeadFont">avares://TheLastPiece/Assets/Fonts#VT323, $Default</FontFamily>
  <FontFamily x:Key="TlpMonoFont">avares://TheLastPiece/Assets/Fonts#IBM Plex Mono SemiBold, avares://TheLastPiece/Assets/Fonts#IBM Plex Mono, $Default</FontFamily>
  <x:Double x:Key="TlpTitleSize">60</x:Double>
  <x:Double x:Key="TlpTitleSpacing">2</x:Double>
  <x:Double x:Key="TlpHeadingSize">30</x:Double>
  <x:Double x:Key="TlpBodySize">14</x:Double>
