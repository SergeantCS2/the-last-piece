<!-- Made by tools/theme-tokens.py from the "PhosphorGreen" palette. Edit the palette there, not this file. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="Tlp.Viewer.Themes.PhosphorGreenTokens">
