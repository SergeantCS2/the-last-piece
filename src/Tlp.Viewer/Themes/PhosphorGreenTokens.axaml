  <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#1A5C33"/>
  <!-- The tube: a warm centre fading to the edges, a glow band that rolls down the screen. -->
  <RadialGradientBrush x:Key="TlpWindowBackground" Center="50%,38%" GradientOrigin="50%,38%" RadiusX="75%" RadiusY="75%">
    <GradientStop Color="#0B2415" Offset="0"/>
    <GradientStop Color="#030A05" Offset="1"/>
  </RadialGradientBrush>
  <LinearGradientBrush x:Key="TlpBand" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Color="#0045FF86" Offset="0"/>
    <GradientStop Color="#1245FF86" Offset="0.5"/>
    <GradientStop Color="#0045FF86" Offset="1"/>
  </LinearGradientBrush>
  <DropShadowEffect x:Key="TlpTitleEffect" Color="#45FF86" BlurRadius="18" OffsetX="0" OffsetY="0" Opacity="1.0"/>
  <DropShadowEffect x:Key="TlpSoftGlow" Color="#45FF86" BlurRadius="8" OffsetX="0" OffsetY="0" Opacity="0.8"/>
</ResourceDictionary>
