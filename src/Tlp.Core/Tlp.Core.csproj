<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>


  <!-- AppInfo.Name and AppInfo.Publisher come from Directory.Build.props. -->
  <Target Name="TlpWriteAppInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <TlpAppInfoFile>$(IntermediateOutputPath)AppInfo.g.cs</TlpAppInfoFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(TlpAppInfoFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
      Lines="namespace Tlp.Core%3B;public static class AppInfo { public const string Name = &quot;$(AppDisplayName)&quot;%3B public const string Publisher = &quot;$(AppPublisher)&quot;%3B }" />
    <ItemGroup>
      <Compile Include="$(TlpAppInfoFile)" />
      <FileWrites Include="$(TlpAppInfoFile)" />
    </ItemGroup>
  </Target>
</Project>
