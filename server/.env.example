# Copy to .env and fill in. Never commit .env.

# Everyone's Syncplay uses this. Don't reuse a password you use elsewhere.
# The host app puts it in each movie night pack, so friends never type it.
SYNCPLAY_PASSWORD=change-me

# Random string; only matters for operator-controlled rooms ("+room" names).
SYNCPLAY_SALT=change-me-too

# Address friends use to reach this machine, as they'd type it.
# Example: https://movies.example.com, or http://203.0.113.7:8080 for a first test.
TLP_PUBLIC_URL=http://localhost:8080
# Host name for Syncplay if it differs from TLP_PUBLIC_URL's host (usually leave empty).
SYNCPLAY_PUBLIC_HOST=
SYNCPLAY_ROOM=movienight

# Your group's name, shown as the big title in everyone's viewer app. Empty shows "Movie night".
TLP_GROUP_NAME=

# Admin page password. Leave empty to have one generated and printed in the logs.
TLP_ADMIN_TOKEN=

# Folder on this machine that holds the episodes to share.
SHELF_DIR=./shelf
# Episodes are deleted this many days after their last movie night, unless pinned.
TLP_RETENTION_DAYS=7
TLP_HTTP_PORT=8080

# Only for `--profile https`: your domain, pointed at this machine. Also set
# TLP_BEHIND_PROXY=true then, so the group torrent tracker sees friends' real addresses.
TLP_DOMAIN=
TLP_BEHIND_PROXY=false

# Group torrents: friends share pieces with each other, your shelf link fills the gaps.
TLP_GROUP_TORRENTS=true

# "Get to my server": the host downloads public magnets onto your shelf itself, so friends
# get your copy. TLP_FETCH_PORT is its torrent port; forwarding it on the router is optional.
TLP_FETCH=true
TLP_FETCH_PORT=6890

# Optional: a Discord webhook (channel settings, Integrations, Webhooks) for the
# "Post to Discord" button on the admin page. Posts never ping anyone.
TLP_DISCORD_WEBHOOK=

# Room helper: the host app keeps a quiet Syncplay connection (shown as "TheLastPiece" in
# room "_thelastpiece") to fill each night's shared playlist and show who's in the room on
# the admin page. Set to false to turn it off.
TLP_ROOM_HELPER=true
