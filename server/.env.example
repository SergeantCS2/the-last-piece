# Copy to .env and fill in. Never commit .env.

# Everyone types this once in Syncplay. Don't reuse a password you use elsewhere.
SYNCPLAY_PASSWORD=change-me

# Random string; only matters for operator-controlled rooms ("+room" names).
SYNCPLAY_SALT=change-me-too

# Shelf (optional file server). Use a hostname like shelf.example.com for real
# HTTPS, or ":8080" to test plain HTTP on your LAN.
SHELF_SITE=:8080
SHELF_USER=movienight
# Generate with: docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
SHELF_PASSWORD_HASH=
# Folder on the host that holds tonight's episodes.
SHELF_DIR=./shelf
